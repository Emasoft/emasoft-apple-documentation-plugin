{
  "name": "emasoft-apple-documentation-plugin",
  "version": "2.0.0",
  "private": true,
  "description": "Apple Developer Documentation for Claude Code: search iOS/macOS/SwiftUI/UIKit docs, WWDC videos, Swift/Objective-C APIs and code examples through a bundled MCP server",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emasoft/emasoft-apple-documentation-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Emasoft/emasoft-apple-documentation-plugin/issues"
  },
  "homepage": "https://github.com/Emasoft/emasoft-apple-documentation-plugin#readme",
  "scripts": {
    "build": "node scripts/build-bundle.mjs",
    "start": "node servers/apple-docs/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "apple",
    "developer-documentation",
    "ios",
    "macos",
    "swift",
    "objective-c",
    "api-search",
    "framework-documentation",
    "sample-code",
    "apple-apis",
    "wwdc"
  ],
  "author": {
    "name": "Emasoft",
    "email": "713559+Emasoft@users.noreply.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "cheerio": "^1.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "0.28.2",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "jsdom": "26.1.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
